# Copiar a .env y completar con los valores reales del dispositivo
API_BASE_URL=http://localhost:8000/api
DEVICE_TOKEN=
DEVICE_NAME=PC Laboratorio A

# Umbrales (también existen como defaults en la tabla `settings` del backend;
# aquí sirven como fallback local si la sincronización con la API falla)
MIN_CONFIDENCE_REJECT=0.50
MIN_CONFIDENCE_TRUST=0.75
DUPLICATE_WINDOW_SECONDS=30

SYNC_INTERVAL_SECONDS=300
LOCAL_QUEUE_DB_PATH=./queue.sqlite3
CATALOG_CACHE_PATH=./face_catalog_cache.json
CAMERA_INDEX=0
